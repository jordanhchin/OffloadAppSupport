#!/bin/bash

set -u
umask 077

SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
    LINK_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)
    SCRIPT_PATH=$(readlink "$SCRIPT_PATH")
    case "$SCRIPT_PATH" in /*) ;; *) SCRIPT_PATH="$LINK_DIR/$SCRIPT_PATH" ;; esac
done
SCRIPT_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)
PROJECT_DIR=$(cd "$SCRIPT_DIR/.." && pwd -P)
APPOFFLOAD_VERSION=$(/bin/cat "$PROJECT_DIR/VERSION" 2>/dev/null || echo "development")
# shellcheck source=../lib/core.sh
. "$PROJECT_DIR/lib/core.sh"
# shellcheck source=../lib/migration.sh
. "$PROJECT_DIR/lib/migration.sh"
trap 'debug_log "signal received; rolling back operation=$ACTIVE_OPERATION phase=$ACTIVE_PHASE"; rollback_active_transaction; exit 130' INT TERM
trap 'debug_log "session-end status=$? error=$APPOFFLOAD_ERROR"' EXIT

usage() {
    printf 'AppSupport Offload %s — safely move ~/Library/Application Support folders\n\n' "$APPOFFLOAD_VERSION"
    cat <<'EOF'
Usage:
  appoffload [--debug]               Open the interactive TUI
  appoffload list                    List local and offloaded folders
  appoffload audit                   Compare installed apps and support folders
  appoffload locations               List installed-app search locations
  appoffload locations add PATH      Persist an additional search location
  appoffload locations remove PATH   Remove a custom search location
  appoffload offload NAME --target /Volumes/DISK
  appoffload offloads                List managed offloads
  appoffload offloads restore NAME
  appoffload offloads move NAME --target /Volumes/DISK
  appoffload offloads delete NAME --yes
  appoffload health                  Scan links, disks, and recovery artifacts
  appoffload health repair NAME      Repair a renamed-volume or missing link
  appoffload health forget NAME --yes
  appoffload health clean-staging PATH --yes
  appoffload health recover-backup PATH --yes
  appoffload health recover-transaction PATH --yes
  appoffload app inspect APP
  appoffload app backup APP --target /Volumes/DISK
  appoffload app backups
  appoffload app backups move BACKUP_PATH --target /Volumes/DISK
  appoffload app backups delete BACKUP_PATH --yes
  appoffload app verify BACKUP_PATH
  appoffload app restore BACKUP_PATH [--app-target DIRECTORY]
  appoffload restore NAME
  appoffload help
  appoffload version

Prefix any command with --debug to write a timestamped diagnostic log to
~/Library/Logs/AppSupportOffload/debug.log. Set APPOFFLOAD_LOG_FILE to use a
different path, or APPOFFLOAD_DEBUG=1 to enable logging without the flag.

Offloads are copied with macOS metadata, SHA-256 verified, and activated with
a symbolic link only after verification. Running apps with open files in the
selected folder block the operation. Restore performs the reverse transaction.
EOF
}

resolve_source() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$APP_SUPPORT_ROOT" "$1" ;;
    esac
}

print_cli_summary() {
    local verb="$1" name="$2" delta="$3"
    printf '\n%s complete: %s\n' "$verb" "$name"
    if [ "$delta" -ge 0 ]; then
        printf 'Local space saved: %s\n' "$(human_bytes "$delta")"
    else
        printf 'Additional local space consumed: %s\n' "$(human_bytes "$((0 - delta))")"
    fi
}

print_external_summary() {
    local verb="$1" name="$2" bytes="$3"
    printf '\n%s complete: %s\n' "$verb" "$name"
    printf 'External data affected: %s\nLocal disk usage unchanged.\n' "$(human_bytes "$bytes")"
}

if [ "${1:-}" = "--debug" ]; then APPOFFLOAD_DEBUG=1; shift; fi
debug_init || { echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; }
command_name="${1:-tui}"
debug_log "command.begin name=$command_name arguments=$#"
if [ -n "$APPOFFLOAD_DEBUG_LOG" ]; then printf 'Debug log: %s\n' "$APPOFFLOAD_DEBUG_LOG" >&2; fi
case "$command_name" in
    tui)
        if [ ! -t 0 ] || [ ! -t 1 ]; then echo "The TUI requires an interactive terminal." >&2; exit 2; fi
        # shellcheck source=../lib/tui.sh
        . "$PROJECT_DIR/lib/tui.sh"
        run_tui
        ;;
    list)
        printf '%-48s %12s  %s\n' "FOLDER" "SIZE" "LOCATION"
        while IFS=$'\t' read -r size status path; do
            printf '%-48s %12s  %s\n' "$(basename "$path")" "$(human_bytes "$size")" "$status"
        done < <(list_folders | sort -t $'\t' -k1,1nr)
        ;;
    audit)
        printf '%-40s %12s  %-11s %s\n' "FOLDER" "SIZE" "ASSESSMENT" "MATCH / REASON"
        while IFS=$'\t' read -r size classification evidence path; do
            printf '%-40s %12s  %-11s %s\n' "$(basename "$path")" "$(human_bytes "$size")" "$(printf '%s' "$classification" | tr '[:lower:]' '[:upper:]')" "$evidence"
        done < <(audit_folders | sort -t $'\t' -k1,1nr)
        ;;
    locations)
        locations_action="${2:-list}"
        case "$locations_action" in
            list)
                [ "$#" -le 2 ] || { usage >&2; exit 2; }
                printf '%-10s %-13s %s\n' "TYPE" "STATUS" "FOLDER"
                while IFS=$'\t' read -r kind status path; do
                    printf '%-10s %-13s %s\n' "$kind" "$status" "$path"
                done < <(list_app_roots)
                ;;
            add)
                [ "$#" -eq 3 ] || { usage >&2; exit 2; }
                if add_app_root "$3" >/dev/null; then echo "Added app search location: $LAST_APP_ROOT"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            remove)
                [ "$#" -eq 3 ] || { usage >&2; exit 2; }
                if remove_app_root "$3"; then echo "Removed app search location: $3"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    offloads)
        offloads_action="${2:-list}"
        case "$offloads_action" in
            list)
                [ "$#" -le 2 ] || { usage >&2; exit 2; }
                printf '%-48s %12s  %s\n' "FOLDER" "SIZE" "TARGET"
                while IFS=$'\t' read -r size status path; do
                    [ "$status" = "offloaded" ] || continue
                    destination=$(managed_link_destination "$path" 2>/dev/null || echo "unavailable")
                    printf '%-48s %12s  %s\n' "$(basename "$path")" "$(human_bytes "$size")" "$destination"
                done < <(list_folders | sort -t $'\t' -k1,1nr)
                ;;
            restore)
                [ "$#" -eq 3 ] || { usage >&2; exit 2; }
                source=$(resolve_source "$3")
                if restore_folder "$source"; then print_cli_summary "Restore" "$(basename "$source")" "$LAST_LOCAL_DELTA_BYTES"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            move)
                [ "$#" -eq 5 ] && [ "$4" = "--target" ] || { usage >&2; exit 2; }
                source=$(resolve_source "$3")
                if move_offload "$source" "$5"; then print_external_summary "Offload move" "$(basename "$source")" "$LAST_EXTERNAL_BYTES"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            delete)
                [ "$#" -eq 4 ] && [ "$4" = "--yes" ] || { echo "Permanent deletion requires: appoffload offloads delete NAME --yes" >&2; exit 2; }
                source=$(resolve_source "$3")
                if delete_offload "$source"; then print_external_summary "Permanent deletion" "$(basename "$source")" "$LAST_EXTERNAL_BYTES"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    health)
        health_action="${2:-scan}"
        case "$health_action" in
            scan)
                [ "$#" -le 2 ] || { usage >&2; exit 2; }
                printf '%-10s %-24s %-28s %s\n' "SEVERITY" "STATUS" "ITEM" "DETAIL"
                while IFS=$'\t' read -r severity status name source destination detail action; do
                    printf '%-10s %-24s %-28s %s\n' "$(printf '%s' "$severity" | tr '[:lower:]' '[:upper:]')" "$status" "$(printf '%.28s' "$name")" "$detail"
                done < <(health_scan)
                ;;
            repair)
                [ "$#" -eq 3 ] || { usage >&2; exit 2; }
                source=$(resolve_source "$3")
                if repair_offload_link "$source"; then echo "Repaired managed link: $source"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            forget)
                [ "$#" -eq 4 ] && [ "$4" = "--yes" ] || { usage >&2; exit 2; }
                source=$(resolve_source "$3")
                if remove_offload_record "$source"; then echo "Removed health record: $source"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            clean-staging)
                [ "$#" -eq 4 ] && [ "$4" = "--yes" ] || { usage >&2; exit 2; }
                if clean_health_staging "$3"; then echo "Removed stale staging data: $3"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            recover-backup)
                [ "$#" -eq 4 ] && [ "$4" = "--yes" ] || { usage >&2; exit 2; }
                if recover_local_backup "$3"; then echo "Recovered local rollback copy: $3"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            recover-transaction)
                [ "$#" -eq 4 ] && [ "$4" = "--yes" ] || { usage >&2; exit 2; }
                if recover_incomplete_transaction "$3"; then echo "Recovered transaction: $3"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    app)
        app_action="${2:-}"
        case "$app_action" in
            inspect)
                [ "$#" -eq 3 ] || { usage >&2; exit 2; }
                resolve_migratable_app "$3" >/dev/null || { echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; }
                app_path=$RESOLVED_MIGRATABLE_APP
                printf '%-10s %12s  %-16s %s\n' "CATEGORY" "SIZE" "SOURCE" "PATH"
                while IFS=$'\t' read -r size category relative source; do printf '%-10s %12s  %-16s %s\n' "$category" "$(human_bytes "$size")" "$(migration_source_kind "$source")" "$source"; done < <(app_migration_inventory "$app_path")
                ;;
            backup)
                [ "$#" -eq 5 ] && [ "$4" = "--target" ] || { usage >&2; exit 2; }
                resolve_migratable_app "$3" >/dev/null || { echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; }
                app_path=$RESOLVED_MIGRATABLE_APP
                if create_app_migration_backup "$app_path" "$5"; then
                    printf '\nMigration backup complete: %s\nItems: %s (%s existing offload(s) materialized)\nData copied: %s\nBackup: %s\nLocal disk usage unchanged.\n' "$LAST_MIGRATION_APP_NAME" "$LAST_MIGRATION_ITEM_COUNT" "$LAST_MIGRATION_OFFLOADED_COUNT" "$(human_bytes "$LAST_EXTERNAL_BYTES")" "$LAST_MIGRATION_BACKUP"
                else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            backups)
                backups_action="${3:-list}"
                case "$backups_action" in
                    list)
                        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
                        printf '%-30s %-34s %12s  %s\n' "APP" "BUNDLE ID" "SIZE" "CREATED"
                        while IFS=$'\t' read -r size name identifier created path; do printf '%-30s %-34s %12s  %s\n' "$(printf '%.30s' "$name")" "$(printf '%.34s' "$identifier")" "$(human_bytes "$size")" "$created"; printf '  %s\n' "$path"; done < <(list_app_migration_backups)
                        ;;
                    move)
                        [ "$#" -eq 6 ] && [ "$5" = "--target" ] || { usage >&2; exit 2; }
                        if move_app_migration_backup "$4" "$6"; then printf 'Migration backup moved and verified: %s\n' "$LAST_MIGRATION_BACKUP"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                        ;;
                    delete)
                        [ "$#" -eq 5 ] && [ "$5" = "--yes" ] || { echo "Permanent deletion requires: appoffload app backups delete BACKUP_PATH --yes" >&2; exit 2; }
                        if delete_app_migration_backup "$4"; then printf 'Migration backup permanently deleted: %s (%s)\n' "$LAST_MIGRATION_APP_NAME" "$(human_bytes "$LAST_EXTERNAL_BYTES")"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                        ;;
                    *) usage >&2; exit 2 ;;
                esac
                ;;
            verify)
                [ "$#" -eq 3 ] || { usage >&2; exit 2; }
                if verify_app_migration_source "$3"; then echo "Migration backup verified: $3"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            restore)
                if [ "$#" -eq 3 ]; then app_target=""; elif [ "$#" -eq 5 ] && [ "$4" = "--app-target" ]; then app_target="$5"; else usage >&2; exit 2; fi
                if restore_app_migration_source "$3" "$app_target"; then
                    printf '\nMigration restore complete: %s\nItems: %s\nLocal space consumed: %s\nThe migration backup was retained.\n' "$LAST_MIGRATION_APP_NAME" "$LAST_MIGRATION_ITEM_COUNT" "$(human_bytes "$((0 - LAST_LOCAL_DELTA_BYTES))")"
                else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    offload)
        [ "$#" -ge 4 ] && [ "$3" = "--target" ] || { usage >&2; exit 2; }
        source=$(resolve_source "$2")
        if offload_folder "$source" "$4"; then print_cli_summary "Offload" "$(basename "$source")" "$LAST_LOCAL_DELTA_BYTES"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
        ;;
    restore)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        source=$(resolve_source "$2")
        if restore_folder "$source"; then print_cli_summary "Restore" "$(basename "$source")" "$LAST_LOCAL_DELTA_BYTES"; else echo "Error: $APPOFFLOAD_ERROR" >&2; exit 1; fi
        ;;
    help|-h|--help) usage ;;
    version|-v|--version) echo "appoffload $APPOFFLOAD_VERSION" ;;
    *) usage >&2; exit 2 ;;
esac
